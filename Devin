# Step 1. Define 3 variables.

int1 = 10000
int2 = 3
int3 = 0

# Step 2. Subtracting, adding, multiplying, and dividing

     #adding 10000+3
addition = int3 + int2
print (f"{int3} + {int2} = {addition}")

      #subtracting 10000-3
subtraction = int1 - int2
print (f"{int1} - {int2} = {subtraction}")

     #multiplying 10000*3
multiply = int1 * int3
print (f"{int1} x {int3} = {multiply}")

     #dividing 10000/3
divide = int1 / int2
    # When dividing by 0, ZeroDivisionError: division by zero, occurs
print (f"{int1} / {int2} = {divide}")

